# Fill GEMINI_API_KEY and restart FastAPI to enable Gemini itinerary generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# sample: no Gemini calls; auto: use Gemini if configured, fall back on errors.
PLANNER_MODE=sample
# Open-Meteo public forecast endpoint needs no key. Reserved for future providers.
WEATHER_API_KEY=
# Cloud Run injects PORT automatically.
PORT=8080
# Public browser key: restrict to Maps Embed API + your website referrers.
GOOGLE_MAPS_EMBED_KEY=
